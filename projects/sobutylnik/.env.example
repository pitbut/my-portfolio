# Скопируйте этот файл в .env и заполните значения для локальной разработки.

# development | testing | production
FLASK_CONFIG=development
FLASK_APP=run.py

SECRET_KEY=change-me-to-a-random-string

# Для разработки не обязателен — по умолчанию используется SQLite (instance/sobutylnik.db).
DATABASE_URL=

# Провайдер ИИ — универсальный слой (app/providers/), на старте реализован
# только "anthropic". Получить ключ: console.anthropic.com
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Сколько реплик даётся гостю без регистрации в демо-режиме на главной,
# прежде чем показать призыв зарегистрироваться.
GUEST_DEMO_TURNS=4

# Стартовый лимит сообщений на нового пользователя (предохранитель от
# разорения на API) — дальше администратор управляет лимитами и общим
# вкл/выкл лимитов из /admin.
DEFAULT_MESSAGE_LIMIT=60

# Пароль для входа в /admin — единственный администратор.
ADMIN_PASSWORD=change-me

# Письма подтверждения регистрации отправляются через HTTP-API Resend
# (resend.com), а не через SMTP — большинство хостингов на бесплатном тарифе
# блокируют исходящие SMTP-соединения. Если оставить пустым — письма не
# отправляются по-настоящему, ссылка подтверждения выводится в лог и на
# страницу после регистрации (удобно для локальной разработки).
#
# ВАЖНО про onboarding@resend.dev (значение MAIL_DEFAULT_SENDER ниже "из
# коробки"): это тестовый адрес самого Resend, с него можно отправлять
# ТОЛЬКО на email, на который зарегистрирован сам Resend-аккаунт. Для
# реальных пользователей: Resend → Domains → подтвердите свой домен, затем
# укажите MAIL_DEFAULT_SENDER с этого домена.
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=Собутыльник <onboarding@resend.dev>

# Срок жизни ссылки подтверждения email, в секундах (86400 = сутки).
CONFIRM_TOKEN_MAX_AGE=86400

# Файлы/фото в чате поддержки грузятся на ImgBB (imgbb.com/api) — Render не
# хранит файлы на диске между деплоями. Если оставить пустым — вложение не
# сохранится постоянно (сообщение всё равно уйдёт админу текстом).
IMGBB_API_KEY=
