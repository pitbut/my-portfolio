# Скопируйте этот файл в .env и заполните значения для локальной разработки.

# development | testing | production
FLASK_CONFIG=development
FLASK_APP=run.py

SECRET_KEY=change-me-to-a-random-string

# Для разработки не обязателен — по умолчанию используется SQLite (instance/ai_tutor.db).
# Для продакшена укажите PostgreSQL, например:
# DATABASE_URL=postgresql://ai_tutor:password@localhost:5432/ai_tutor
DATABASE_URL=

# Единый мультимодальный ИИ-API (текст + изображения) — раздел 6 ТЗ. Один
# ключ обслуживает ведение занятия, генерацию программы (offline-скрипт) и
# проверку решений по фото. Получить ключ: console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Минимальный отступ до следующего занятия, в часах (раздел 4.2 ТЗ).
NEXT_LESSON_MIN_OFFSET_HOURS=3

# Минимум практических заданий за занятие (раздел 4.2 ТЗ).
MIN_TASKS_PER_LESSON=3

# Имя дефолтного аватара, пока ученик не выбрал свой на онбординге.
DEFAULT_AVATAR_NAME=Алекс

# Пароль для входа в /admin — управление предметами/классами/программами и
# просмотр прогресса учеников (раздел 9.3 ТЗ).
ADMIN_PASSWORD=change-me

# Письма подтверждения регистрации отправляются через HTTP-API Resend
# (resend.com), а не через SMTP — большинство хостингов на бесплатном тарифе
# блокируют исходящие SMTP-соединения. Если оставить пустым — письма не
# отправляются по-настоящему, ссылка подтверждения выводится в лог и на
# страницу после регистрации (удобно для локальной разработки).
#
# ВАЖНО про onboarding@resend.dev (значение MAIL_DEFAULT_SENDER ниже "из
# коробки"): это тестовый адрес самого Resend, и с него можно отправлять
# ТОЛЬКО на email, на который зарегистрирован сам Resend-аккаунт — на любой
# другой Resend ответит 403 "Testing domain restriction" (видно в Resend →
# Logs), а ученику письмо не придёт. Для реальных учеников с разными email
# нужно: Resend → Domains → добавить и подтвердить свой домен (DNS-записи,
# для этого сайта подойдёт robutpit.com), затем заменить MAIL_DEFAULT_SENDER
# на адрес с этого домена, например "ИИ-репетитор <noreply@robutpit.com>".
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=ИИ-репетитор <onboarding@resend.dev>

# Срок жизни ссылки подтверждения email, в секундах (86400 = сутки).
CONFIRM_TOKEN_MAX_AGE=86400

# Фото решений загружаются на ImgBB (imgbb.com/api) для отображения в
# истории занятия — Render не хранит файлы на диске между деплоями. Если
# оставить пустым — проверка решения всё равно работает (фото анализируется
# напрямую через ANTHROPIC_API_KEY), просто ссылка на фото не сохраняется.
IMGBB_API_KEY=
