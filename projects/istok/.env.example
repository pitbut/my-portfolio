# Скопируйте этот файл в .env и заполните значения для локальной разработки.

# development | testing | production
FLASK_CONFIG=development
FLASK_APP=run.py

SECRET_KEY=change-me-to-a-random-string

# Для разработки не обязателен — по умолчанию используется SQLite (instance/istok.db).
# Для продакшена укажите PostgreSQL, например:
# DATABASE_URL=postgresql://istok:password@localhost:5432/istok
DATABASE_URL=

ITEMS_PER_PAGE=9

# Пароль для входа в /admin — панель модерации предложенных правок.
ADMIN_PASSWORD=change-me

# true — seed.py всегда стирает и перезаливает БД из data/*.csv, даже если
# в ней уже есть данные (в т.ч. одобренные через /admin правки).
# false (по умолчанию) — заполняет только пустые таблицы.
FORCE_RESEED=false

# Письма подтверждения регистрации отправляются через HTTP-API Resend
# (resend.com), а не через SMTP — большинство хостингов на бесплатном тарифе
# блокируют исходящие SMTP-соединения. Если RESEND_API_KEY оставить пустым —
# письма не отправляются по-настоящему, ссылка подтверждения выводится в лог
# и на страницу после регистрации (удобно для локальной разработки).
RESEND_API_KEY=
# Без верификации своего домена в Resend можно отправлять только с их
# тестового адреса onboarding@resend.dev — он и используется по умолчанию.
MAIL_DEFAULT_SENDER=Исток <onboarding@resend.dev>

# Срок жизни ссылки подтверждения email, в секундах (86400 = сутки).
CONFIRM_TOKEN_MAX_AGE=86400

# Срок жизни ссылки восстановления пароля, в секундах (3600 = час).
PASSWORD_RESET_TOKEN_MAX_AGE=3600

# Загруженные пользователями фото (оборудование, точки продажи, отзывы,
# предложения правок к источникам) отправляются на ImgBB (imgbb.com/api) —
# Render не хранит файлы на диске между деплоями. Бесплатный API-ключ:
# imgbb.com → раздел API. Если оставить пустым — поле загрузки фото просто
# не сработает (форма отправится без фото).
IMGBB_API_KEY=

# Вход через Google (OAuth 2.0). Получить в Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (тип "Веб-приложение").
# Authorized redirect URI: <адрес сайта>/auth/google/callback
# Если оставить пустыми — кнопка "Войти через Google" на сайте не показывается.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram-бот: уведомления о новых личных сообщениях (раздел «Сообщения»)
# прямо в Telegram, с привязкой аккаунта на странице «Сообщения → Telegram».
# 1. Создайте бота через @BotFather в Telegram — получите TELEGRAM_BOT_TOKEN
#    и его юзернейм без @ (TELEGRAM_BOT_USERNAME).
# 2. TELEGRAM_WEBHOOK_SECRET — произвольная случайная строка, часть пути
#    вебхука (/telegram/webhook/<эта_строка>) — так его не сможет вызвать
#    кто-то посторонний, зная только адрес сайта.
# 3. После деплоя один раз выполните (подставив свои значения):
#      curl -F "url=https://<ваш-домен>/telegram/webhook/<секрет>" \
#           https://api.telegram.org/bot<TOKEN>/setWebhook
# Без TELEGRAM_BOT_TOKEN уведомления идут только в личном кабинете сайта —
# сама привязка Telegram-аккаунта (кнопка на странице «Сообщения») при этом
# уже работает и покажет код/ссылку, просто бот пока не сможет ответить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Необязательно: если задан chat_id, сообщения в «Администрацию» тоже
# дублируются в этот чат (у администрации нет своего аккаунта на сайте,
# поэтому её нельзя привязать через обычную страницу «Telegram»). Получить
# chat_id — написать своему боту любое сообщение и открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates.
ADMIN_TELEGRAM_CHAT_ID=
