<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <AutoCompleteTextView
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/field_bg"
            android:completionThreshold="1"
            android:dropDownWidth="match_parent"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/reload"
            style="@style/BarButton"
            android:contentDescription="Обновить"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@drawable/progress"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/field_bg"
            android:hint="Найти на странице"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="@color/muted" />

        <ImageButton android:id="@+id/findPrev" style="@style/BarButton" android:contentDescription="Предыдущее" android:src="@drawable/ic_up" />
        <ImageButton android:id="@+id/findNext" style="@style/BarButton" android:contentDescription="Следующее" android:src="@drawable/ic_down" />
        <ImageButton android:id="@+id/findClose" style="@style/BarButton" android:contentDescription="Закрыть поиск" android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/back" style="@style/BottomButton" android:contentDescription="Назад" android:src="@drawable/ic_back" />
        <ImageButton android:id="@+id/forward" style="@style/BottomButton" android:contentDescription="Вперёд" android:src="@drawable/ic_forward" />
        <ImageButton android:id="@+id/home" style="@style/BottomButton" android:contentDescription="Домой" android:src="@drawable/ic_home" />

        <FrameLayout
            android:id="@+id/tabsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ripple"
            android:contentDescription="Вкладки">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/tabs_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton android:id="@+id/menu" style="@style/BottomButton" android:contentDescription="Меню" android:src="@drawable/ic_more" />
    </LinearLayout>
</LinearLayout>
