# Скопируйте этот файл в .env и заполните значения для локальной разработки.

# development | testing | production
FLASK_CONFIG=development
FLASK_APP=run.py

SECRET_KEY=change-me-to-a-random-string

# Для разработки не обязателен — по умолчанию SQLite (instance/b2b_platform.db).
# Для продакшена — PostgreSQL, например:
# DATABASE_URL=postgresql://user:password@localhost:5432/b2b_platform
DATABASE_URL=

# Письма подтверждения регистрации отправляются через HTTP-API Resend
# (resend.com) — большинство хостингов на бесплатном тарифе блокируют
# исходящие SMTP-соединения. Если оставить пустым — письма не отправляются
# по-настоящему, ссылка подтверждения выводится в лог и на страницу сайта
# (удобно для локальной разработки).
#
# ВАЖНО: адрес onboarding@resend.dev — тестовый домен Resend, с него письма
# уходят ТОЛЬКО на почту владельца аккаунта Resend, всем остальным — 403
# Testing domain restriction. После верификации своего домена в Resend
# (Domains -> Add domain) укажите здесь адрес на этом домене, например
# noreply@robutpit.com, иначе письма не будут доходить до пользователей.
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=B2B Platform <noreply@robutpit.com>
CONFIRM_TOKEN_MAX_AGE=86400

# Вход через Google (OAuth 2.0). Получить в Google Cloud Console -> APIs &
# Services -> Credentials -> OAuth client ID (тип: Web application).
# Authorized redirect URI должен быть:
#   http://localhost:5000/auth/google/callback (для разработки)
#   https://<ваш-домен>/auth/google/callback (для продакшена)
# Если оставить пустым — кнопка «Войти через Google» на сайте просто не
# показывается, регистрация по email продолжает работать в полном объёме.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Загруженные пользователями фото (заказы, объявления барахолки,
# доказательства в спорах) уходят на ImgBB (imgbb.com/api) — Render не
# хранит файлы на диске между деплоями. Бесплатный API-ключ: imgbb.com ->
# раздел API. Если оставить пустым — поле загрузки фото просто не сработает.
IMGBB_API_KEY=

# Telegram-бот (модуль 7). Создайте бота через @BotFather в Telegram —
# получите TELEGRAM_BOT_TOKEN и юзернейм (без @) в TELEGRAM_BOT_USERNAME.
# TELEGRAM_WEBHOOK_SECRET — произвольная случайная строка, часть пути
# вебхука (/telegram/webhook/<эта_строка>); после деплоя один раз выполните:
#   curl -F "url=https://<ваш-домен>/telegram/webhook/<секрет>" \
#        https://api.telegram.org/bot<TOKEN>/setWebhook
# Без TELEGRAM_BOT_TOKEN уведомления идут только в личном кабинете сайта —
# привязка Telegram-аккаунта (кнопка в «Настройках») при этом уже работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Нужен только для абсолютных ссылок в Telegram-сообщениях, если
# уведомление формируется вне HTTP-запроса. Обычно можно оставить пустым.
PUBLIC_BASE_URL=
