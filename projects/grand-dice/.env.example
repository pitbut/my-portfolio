# Скопируйте этот файл в .env и заполните значения для локальной разработки.

FLASK_CONFIG=development
FLASK_APP=run.py

SECRET_KEY=change-me-to-a-random-string

# Для разработки не обязателен — по умолчанию используется SQLite (instance/grand_dice.db).
# Для продакшена укажите PostgreSQL, например:
# DATABASE_URL=postgresql://grand_dice:password@localhost:5432/grand_dice
DATABASE_URL=

# Письма (подтверждение регистрации, OTP на вывод средств) отправляются
# через HTTP-API Resend (resend.com), а не через SMTP — большинство
# хостингов на бесплатном тарифе блокируют исходящие SMTP-соединения. Если
# RESEND_API_KEY оставить пустым — письма не отправляются по-настоящему,
# содержимое выводится в лог и (в demo-режиме без почты) прямо на странице.
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=Grand Dice <onboarding@resend.dev>

# Срок жизни ссылки подтверждения email, в секундах (86400 = сутки).
CONFIRM_TOKEN_MAX_AGE=86400

# Срок жизни ссылки восстановления пароля, в секундах (3600 = час).
RESET_TOKEN_MAX_AGE=3600

# Срок жизни OTP-кода на вывод средств, в секундах (600 = 10 минут).
OTP_MAX_AGE=600

# Стартовый демо-баланс для новых аккаунтов.
STARTING_DEMO_BALANCE=1000

# Комиссия казино в игре в кости, в процентах.
HOUSE_EDGE_PERCENT=1.0

MIN_DEPOSIT_AMOUNT=10
MIN_WITHDRAW_AMOUNT=10

# Первый администратор создаётся seed.py при деплое, если такого
# пользователя ещё нет. После первого входа поменяйте пароль.
ADMIN_EMAIL=
ADMIN_PASSWORD=
